rules_version = '2';

// ============================================================
// KITE — Firestore Security Rules (the real lock on the data)
// Paste this whole file into: Firebase Console → Firestore
// Database → Rules → Publish. See SETUP.md Step 2f.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn() && myDoc().active == true;
    }
    function myRole() {
      return myDoc().role;
    }
    function isAdmin() {
      return isActive() && myRole() in ['admin', 'superadmin'];
    }
    function isSuper() {
      return isActive() && myRole() == 'superadmin';
    }
    // Staff Handles automatically have access to all rooms + media rights
    function isElevated() {
      return isActive() && myRole() in ['staff', 'admin', 'superadmin'];
    }
    function inRoom(roomId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(roomId));
    }

    // ---------- users: directory HIDDEN from members ----------
    match /users/{uid} {
      // You may read only YOUR OWN profile; Admins see the full directory.
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Accounts are minted by Admins only (invite-only platform).
      // Only SuperAdmin can mint privileged roles, and nobody self-registers.
      allow create: if isAdmin()
        && request.resource.data.role in ['member', 'staff', 'admin']
        && (request.resource.data.role == 'member' || isSuper());
      // Self-service: you may change YOUR OWN handle — nothing else (the
      // field-diff check blocks any attempt to touch role/active/onCall).
      // Role changes & staff on-call: SuperAdmin. Activate/deactivate: Admins.
      // Nobody can touch a SuperAdmin account.
      allow update: if (isActive() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handle'])
          && request.resource.data.handle is string
          && request.resource.data.handle.size() >= 2
          && request.resource.data.handle.size() <= 24)
        || (isAdmin()
          && resource.data.role != 'superadmin'
          && (request.resource.data.role == resource.data.role || isSuper()));
      // Delete (permanent removal): Admins may delete members;
      // only the SuperAdmin may delete staff/admin accounts.
      allow delete: if isSuper() || (isAdmin() && resource.data.role == 'member');

      // Membership records let a member list their own rooms WITHOUT ever
      // seeing who else is in them. Written exclusively by Admins.
      match /memberships/{roomId} {
        allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ---------- anonymous presence heartbeats ----------
    // Docs contain ONLY a timestamp (doc id = uid). Since member profiles
    // are unreadable to other members, no identity is exposed.
    match /presence/{uid} {
      allow read: if isActive();
      allow create, update: if isActive() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastActive']);
      // Admins may clean up the presence doc of a deleted account.
      allow delete: if (isActive() && request.auth.uid == uid) || isAdmin();
    }

    // status/staff holds one number: how many Staff Handles are On-Call.
    match /status/staff {
      allow read: if isActive();
      allow write: if isSuper();
    }

    // ---------- Main Broadcast Channel: Admins post, everyone reads ----------
    match /broadcast/{postId} {
      allow read: if isActive();
      allow create: if isAdmin() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- General Community Room: EMOJI ONLY ----------
    match /community/{reactionId} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'emoji', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.emoji in ['👍', '🙏', '🔥', '💪', '🎉', '❤️', '👏', '✅'];
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Admin-locked private rooms ----------
    match /rooms/{roomId} {
      allow read: if isElevated() || (isActive() && inRoom(roomId));
      allow create, update, delete: if isAdmin();

      // Participant manifest — Admins/SuperAdmins ONLY. Members can never
      // read this, so they can never see who else is in a room.
      match /acl/{aclDoc} {
        allow read, write: if isAdmin();
      }

      match /messages/{messageId} {
        allow read: if isElevated() || (isActive() && inRoom(roomId));
        allow create: if (isElevated() || (isActive() && inRoom(roomId)))
          && request.resource.data.authorUid == request.auth.uid
          // Standard members may NOT attach media anywhere:
          && (isElevated() || !('mediaUrl' in request.resource.data));
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Fillable forms published inside the room by Admins.
      match /forms/{formId} {
        allow read: if isElevated() || (isActive() && inRoom(roomId));
        allow create, update, delete: if isAdmin();
      }

      // Form/signature submissions: strictly private — the submitter and
      // Admins only. No member can ever read another member's answers.
      match /submissions/{submissionId} {
        allow create: if isActive() && inRoom(roomId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['uid', 'handle', 'formId', 'answers', 'submittedAt']);
        allow read: if isAdmin()
          || (isActive() && resource.data.uid == request.auth.uid);
        // The submitter may revise their own submission while the form is open.
        allow update: if isActive() && inRoom(roomId)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/rooms/$(roomId)/forms/$(resource.data.formId)).data.open == true;
        allow delete: if isAdmin();
      }
    }

    // ---------- Direct Messages: private 1-on-1 ----------
    // Thread id must equal "<uidA>_<uidB>" with the two uids sorted, which
    // pins every thread to exactly its two participants.
    match /dms/{threadId} {
      function isParticipant() {
        return isActive() && request.auth.uid in resource.data.participants;
      }
      function validThread() {
        return request.resource.data.participants.size() == 2
          && request.auth.uid in request.resource.data.participants
          && threadId == request.resource.data.participants[0]
                         + '_' + request.resource.data.participants[1];
      }
      // SuperAdmin read powers the centralized Staff master inbox and
      // compliance oversight.
      allow read: if isParticipant() || isSuper();
      allow create: if isActive() && validThread();
      // Participants update normally; SuperAdmin may update thread metadata
      // (last message, read markers) when triaging the master inbox —
      // but nobody can ever change WHO a thread belongs to.
      allow update: if (isParticipant() && validThread()
          && request.resource.data.participants == resource.data.participants)
        || (isSuper()
          && request.resource.data.participants == resource.data.participants);
      allow delete: if isSuper();

      match /messages/{messageId} {
        function threadData() {
          return get(/databases/$(database)/documents/dms/$(threadId)).data;
        }
        function senderIsManagedStaff() {
          return get(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.role == 'staff';
        }
        allow read: if isSuper()
          || (isActive() && request.auth.uid in threadData().participants);
        // Normal case: you send as yourself. Master-inbox case: the
        // SuperAdmin replies AS one of their managed Staff Handles.
        allow create: if (isActive()
            && request.auth.uid in threadData().participants
            && request.resource.data.senderUid == request.auth.uid)
          || (isSuper()
            && request.resource.data.senderUid in threadData().participants
            && senderIsManagedStaff());
        allow update: if false;
        allow delete: if isSuper();
      }
    }

    // ---------- Milestones & funded outcomes ----------
    // Each milestone belongs to ONE member. A member reads ONLY their own —
    // never another member's progress, blockers or funding, even when they
    // share a room. Admins and Staff Handles see all; only Admins write.
    match /milestones/{milestoneId} {
      allow read: if isElevated()
        || (isActive() && resource.data.ownerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // ---------- Admin alerts to one member ----------
    // Written by Admins, addressed to a single member. The recipient may read
    // it and mark it read (nothing else); no member can read another's alerts.
    match /alerts/{alertId} {
      allow read: if isAdmin()
        || (isActive() && resource.data.targetUid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isActive() && resource.data.targetUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read', 'readAt']));
    }

    // ---------- Compliance & event logs ----------
    // Append-only audit trail of high-level metadata (no content).
    // Written by the app as actions happen; readable by Admins only;
    // NOBODY can edit or delete an audit entry.
    match /complianceLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['actorUid', 'category', 'meta', 'at']);
      allow update, delete: if false;
    }

    // Everything not explicitly allowed above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
